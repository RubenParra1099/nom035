# Neon / Vercel Postgres: URL con pooling y URL directa
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Genera con: openssl rand -base64 32
AUTH_SECRET=""
# Primer usuario administrador (lo crea `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@tuempresa.com"
SEED_ADMIN_PASSWORD="cambia-esta-contraseña"
